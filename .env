# تنظیمات سرور Socket.IO | Socket.IO Server Configuration
# برای تست محلی روی گوشی‌ها، IP لپ‌تاپ را وارد کنید
# For testing on mobile phones, replace with your laptop IP address

# مثال: VITE_SOCKET_URL=http://192.168.x.x:3001
# Example: VITE_SOCKET_URL=http://192.168.1.100:3001

VITE_SOCKET_URL=http://192.168.254.13:3001
