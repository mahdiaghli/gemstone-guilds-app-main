# Browser client connection to the Node/Socket.IO server.
VITE_SOCKET_URL=http://localhost:3001

# Use your computer LAN IP when testing from a physical phone, for example:
# VITE_SOCKET_URL=http://192.168.1.108:3001

# Set true only when store builds require an active subscription.
VITE_REQUIRE_PREMIUM=false

# Use a long, random, stable value in production so sessions survive restarts.
AUTH_SECRET=replace-with-a-long-random-secret

# PostgreSQL is the production user store. When omitted, local JSON is used for development.
# DATABASE_URL=postgresql://postgres:password@localhost:5432/gemstone_guilds
# PGSSL=false